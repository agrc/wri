{
  "name": "@ugrc/wri",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:shared && tsc -b && vite build",
    "build:shared": "tsc -p functions/shared/tsconfig.json",
    "build:shared:watch": "tsc -p functions/shared/tsconfig.json --watch",
    "build-storybook": "storybook build",
    "check": "pnpm build:shared && tsc -b",
    "clean:shared": "rimraf functions/shared/dist functions/shared/tsconfig.tsbuildinfo",
    "copy:arcgis": "cpy \"./node_modules/@arcgis/core/assets/**\" ./public/js/ugrc/assets",
    "dev:extractions-test": "pnpm build:shared && vite --open /extractions.test.html",
    "dev:firebase-emulators": "./scripts/start-emulators.sh",
    "dev:vite": "pnpm build:shared && vite",
    "dev:vite:stack": "vite",
    "format": "prettier . --write",
    "postinstall": "pnpm copy:arcgis",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "pnpm --filter @ugrc/wri-functions start:local",
    "start:ci": "pnpm build:shared && vite --host",
    "start:stack": "pnpm build:shared && concurrently 'pnpm build:shared:watch' 'pnpm --filter @ugrc/wri-functions build:watch:only' 'pnpm dev:firebase-emulators' 'wait-on http://127.0.0.1:5001/ut-dnr-dwr-wri-app-at/us-west3/healthCheck && pnpm dev:vite:stack'",
    "storybook": "storybook dev -p 6006",
    "test": "pnpm build:shared && vitest"
  },
  "browserslist": {
    "production": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@arcgis/core": "^5.1.27",
    "@arcgis/lumina": "^5.1.27",
    "@arcgis/map-components": "^5.1.27",
    "@esri/calcite-components": "^5.2.0",
    "@tanstack/react-query": "^5.105.0",
    "@terraformer/arcgis": "^2.2.2",
    "@ugrc/eslint-config": "^1.3.1",
    "@ugrc/esri-theme-toggle": "^2.0.1",
    "@ugrc/utah-design-system": "^4.3.2",
    "@ugrc/utilities": "^5.0.1",
    "@ugrc/wri-shared": "link:./functions/shared",
    "betterknown": "^1.2.0",
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "firebase-functions": "^7.4.0",
    "immer": "^11.2.9",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-content-loader": "^7.1.2",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-stately": "3.51.0",
    "shpjs": "^6.2.0",
    "tailwind-merge": "2.6.1",
    "tailwind-variants": "0.3.1",
    "use-immer": "^0.11.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/addon-links": "^10.6.4",
    "@storybook/react-vite": "^10.6.4",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/shpjs": "^3.4.7",
    "@types/terraformer__arcgis": "^2.0.5",
    "@ugrc/tsconfigs": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "firebase-tools": "^15.34.1",
    "lucide-react": "^1.61.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "rimraf": "^6.1.3",
    "storybook": "^10.6.4",
    "tailwindcss": "^3.4.19",
    "tailwindcss-react-aria-components": "^1.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-package-version": "^1.1.0",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
